# === ОБЯЗАТЕЛЬНО ===

# Ключ доступа к аккаунту продавца на FunPay (golden_key из cookies).
FUNPAY_GOLDEN_KEY=paste_your_funpay_golden_key_here

# API-ключ GAMEAU ( gameau.us -> API для интеграций ).
GAMEAU_API_KEY=paste_your_gameau_api_key_here

# === TELEGRAM NOTIFIER (Уведомления владельцу) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === ФИНАНСОВАЯ МОДЕЛЬ (Крипта USDT TRC-20 & Способы заведения) ===
# Активный вариант пополнения:
# 1 = Анонимный обмен / P2P (курс ~110.00 RUB)
# 2 = Беларусь Whitebird без P2P (курс ~87.63 RUB)
EXCHANGE_VARIANT=2

# Курс пополнения Вариант 1 (Анонимный обмен P2P / BestChange / Telegram Wallet)
RATE_VARIANT_1=110.00

# Курс пополнения Вариант 2 (Беларусь Whitebird легальный обмен картой)
RATE_VARIANT_2=87.63
WHITEBIRD_USDT_RATE=87.63

# Лимит списания maxCharge в USDT для защиты от списания баланса в минус.
# Для заказов крупнее 1000⭐ лимит считается автоматически от цены пакета
# (см. MAX_CHARGE_MARGIN_PCT), поэтому он работает как нижняя граница.
DEFAULT_MAX_CHARGE_USDT=9.50
# На сколько % превышаем цену пакета из каталога в maxCharge (запас на рост цены)
MAX_CHARGE_MARGIN_PCT=5
# Оценка себестоимости, когда каталог GAMEAU недоступен (USDT за 1000 звёзд)
USDT_PER_1000_STARS=9.10
# Скрывать отправителя звёзд (hide_sender в GAMEAU)
HIDE_SENDER=false

# === ТРЕКИНГ ВЫПОЛНЕНИЯ ЗАДАЧ ===
# Задача считается "зависшей" после N минут без движения (алерт + reconcile)
STUCK_TASK_MINUTES=20
# Как часто согласовывать незавершённые заказы с GAMEAU API (секунды)
RECONCILIATION_INTERVAL_SEC=60
# Повторные попытки запроса GAMEAU при сетевых сбоях (429/502/503/504)
MAX_ORDER_RETRIES=2
# Сколько ждать финальный статус заказа GAMEAU (секунды)
WAIT_COMPLETION_TIMEOUT=120

# === СТАТИСТИКА / ОТЧЁТНОСТЬ ===
# Авто-отправка статистики (1ч/24ч/сегодня/всего) в Telegram каждые N минут.
# 0 = выключено (ручной вывод: python -m autostars.main --stats / --report)
STATS_PUSH_INTERVAL_MIN=0

# === ОТВЕТЧИВОСТЬ И УСТОЙЧИВОСТЬ (v2.2) ===
# Чат-мониторинг: как часто проверять чаты заказов WAITING_USERNAME,
# чтобы подхватить @username, который покупатель написал в чате FunPay
CHAT_MONITOR_INTERVAL_SEC=15
# Алерт владельцу, если баланс GAMEAU упал ниже порога (USDT)
LOW_BALANCE_THRESHOLD_USDT=50.0
# Как часто проверять баланс GAMEAU (минуты)
BALANCE_CHECK_INTERVAL_MIN=10

# === ПАРАЛЛЕЛИЗМ И ОСТАНОВКА ===
# Сколько заказов обрабатывать одновременно (семафор выдачи)
MAX_CONCURRENT_ORDERS=4
# Сколько секунд при остановке ждать завершения начатых выдач (graceful shutdown)
SHUTDOWN_TIMEOUT_SEC=30
# Повторы логина FunPay при старте, если сайт недоступен
STARTUP_RETRY_DELAY=15
# 0 = пытаться вечно (рекомендуется с systemd Restart=always); N = N попыток и выход
STARTUP_MAX_RETRIES=0

# === ЛОГИРОВАНИЕ ===
LOG_FILE=autostars.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# === ОПЦИОНАЛЬНО ===
# Базовый адрес API GAMEAU (движок сам пробует и /api/v1, и /api)
GAMEAU_BASE_URL=https://gameau.us/api/v1
# Путь к SQLite базе данных
DB_PATH=autostars.db
# Интервал опроса заказов в секундах
POLL_INTERVAL=5.0
# User-Agent для запросов к FunPay (403 от FunPay чаще всего лечится именно им)
#FUNPAY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
# Адрес сайта FunPay (менять нужно только при работе через зеркало/прокси)
FUNPAY_BASE_URL=https://funpay.com
# Сеть до GAMEAU: таймаут запроса (сек) и число повторов при сетевых сбоях
GAMEAU_TIMEOUT=20
GAMEAU_MAX_RETRIES=3
# Звёзды по умолчанию, если количество не распознано в сообщении покупателя
DEFAULT_STARS_QUANTITY=1000
# Комиссия завода USDT за транзакцию (₽) — влияет на прибыль в отчётах
TRON_ENERGY_FEE_RUB=0

# === ПОЛИТИКА ВЫДАЧИ (защита от убытка) ===
# Все проверки выполняются ДО запроса в GAMEAU: списанные USDT обратно не вернуть.
# 0 = проверка выключена (поведение прежних версий).
# Крупная сделка: выручка больше этой суммы -> заказ задерживается (HOLD_MANUAL).
MAX_ORDER_REVENUE_RUB=0
# Минимальная маржа в % от выручки: ниже -> держим. Считается по курсу выбранного
# варианта обмена (EXCHANGE_VARIANT), поэтому ставьте реалистичный порог (5-15).
MIN_MARGIN_PCT=0
# Суточный бюджет закупки в USDT: сколько суммарно можно потратить с полуночи.
# Превышение -> держим (защита от «съевшего» баланс сбоя или серии дублей).
DAILY_SPEND_LIMIT_USDT=0
# «Тот же ник и то же количество» внутри окна = подозрение на дубль оплаченного лота
DUPLICATE_WINDOW_MIN=15
# Что делать с дублем: alert (пишем и выдаём), hold (держим до решения), ignore
DUPLICATE_ACTION=alert
# Чёрный список покупателей (autostars --blacklist add @nick причина)
BLACKLIST_ENABLED=true
# Задержанный заказ: autostars --held, затем --release <ID> -y или --cancel <ID> -y

# === ОТВЕТЫ ПОКУПАТЕЛЮ (шаблоны) ===
# Пустое значение = сообщение не отправляется. Многострочные тексты — в двойных
# кавычках, перенос строки пишется как \n. Доступные подстановки:
# {username} {quantity} {quantity_spaces} {order_id} {price_rub} {reason}
REPLY_NEED_USERNAME="Здравствуйте! Не удалось автоматически распознать ваш Telegram @username. Пожалуйста, напишите его ответным сообщением в формате: @username"
REPLY_DELIVERED="✅ Здравствуйте! {quantity_spaces} Telegram Stars успешно зачислены на аккаунт @{username}.\n\nПожалуйста, проверьте баланс в Telegram и подтвердите успешное выполнение заказа на FunPay! Спасибо за покупку!"
# Ответ, когда заказ задержан политикой (по умолчанию молчим — покупатель ждёт)
REPLY_HOLD=""
# Ответ, когда выдача не удалась (по умолчанию молчим: проще решить вручную, чем обещать возврат)
REPLY_ERROR=""

# === УВЕДОМЛЕНИЯ И МОНИТОРИНГ ===
# «Тихие часы» для некритичных сообщений (успешная сделка, плановая статистика):
# формат 23-07 или 23:00-07:00. Ошибки, низкий баланс и задержки приходят всегда.
MUTE_HOURS=
# Метрики Prometheus + /healthz: по умолчанию выключены и слушают только localhost.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9155
# Строка Authorization: Bearer <token> — если проксируете наружу через nginx/caddy
METRICS_TOKEN=

# === ОЦЕНКИ «НА ПАЛЬЦАХ», КОГДА КАТАЛОГ GAMEAU НЕДОСТУПЕН ===
# Себестоимость одной звезды в USD и цена продажи на FunPay в ₽ за звезду
COST_PER_STAR_USD=0.017
REVENUE_PER_STAR_RUB=1.5
# Курс USD→₽ для грубых оценок (для точных денег задайте RATE_VARIANT_1/2)
USD_TO_RUB=100
# Правила распознавания количества звёзд из текста лота (JSON-массив)
#LOT_RULES=[]
