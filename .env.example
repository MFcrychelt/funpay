# === ОБЯЗАТЕЛЬНО ===

# Ключ доступа к аккаунту продавца на FunPay.
# Взять: профиль на FunPay → иконка ключа («Платёжные данные»/«Настройки») →
# «Ключ доступа» (иногда называют golden_key). Это значение из куки/настроек
# вида длинной строки. НЕ передавайте его никому.
FUNPAY_GOLDEN_KEY=paste_your_funpay_golden_key_here

# API-ключ GAMEAU.
# Взять: профиль на gameau.us → «API для интеграций» → «Выпустить ключ».
# Ключ показывается только один раз — сохраните его сразу.
GAMEAU_API_KEY=paste_your_gameau_api_key_here

# === ОПЦИОНАЛЬНО ===

# Базовый адрес API GAMEAU (по умолчанию менять не нужно).
#GAMEAU_BASE_URL=https://gameau.us/api/v1

# User-Agent, под которым бот ходит на FunPay (лучше свой из браузера).
#FUNPAY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
